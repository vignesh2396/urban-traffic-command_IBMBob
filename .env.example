# ── LLM Configuration ────────────────────────────────────────────────────────
# Google Gemini (preferred — SkillsBuild guideline §3)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash

# ── Weather API (optional — free tier) ───────────────────────────────────────
# Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use default: data/traffic_data.db
DB_PATH=

# ── ChromaDB (RAG) ────────────────────────────────────────────────────────────
# Leave blank to use default: rag/chroma_store
CHROMA_PATH=

# ── Detection Thresholds ─────────────────────────────────────────────────────
DENSITY_THRESHOLD=0.75
SPEED_THRESHOLD_KMPH=20.0
CRITICAL_SEVERITY=9
HIGH_SEVERITY=7

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Leave blank to use default: logs/app.log
LOG_FILE=

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_TOP_K=3
EMBEDDING_MODEL=models/gemini-embedding-001
